{
  "expo": {
    "name": "WA Direct",
    "slug": "wa-direct",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.david.wadirect",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#25D366"
      }
    },
    "ios": {
      "bundleIdentifier": "com.david.wadirect",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7e203025-24da-4f3b-b916-1573cdaecfca"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#f0f2f5"
        }
      ]
    ]
  }
}
