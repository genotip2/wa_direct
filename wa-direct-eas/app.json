{
  "expo": {
    "name": "WA Direct",
    "slug": "wa-direct",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f2f5"
    },
    "android": {
      "package": "com.david.wadirect",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#25D366"
      }
    },
    "ios": {
      "bundleIdentifier": "com.david.wadirect",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-clipboard"
    ]
  }
}
